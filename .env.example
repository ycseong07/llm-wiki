# Personal RAG (llm_wiki) — .env example
# 실제 값은 Windows Credential Manager(keyring) 경유 권장. .env 사용 시 git 커밋 금지.
# 자세한 보안 모델: PROJECT_PLAN.md §4

# --- Vault & 데이터 경로 (BitLocker 드라이브 권장) ---
VAULT_PATH=D:\ObsidianVault
QDRANT_STORAGE_PATH=D:\qdrant_storage

# --- Qdrant (127.0.0.1만 노출) ---
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=changeme-or-load-via-keyring

# --- FastAPI / MCP 서버 ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
JWT_SECRET=changeme-or-load-via-keyring
JWT_EXPIRY_MIN=15
JWT_REFRESH_DAYS=7

# --- Langfuse (self-host) ---
LANGFUSE_HOST=http://127.0.0.1:3000
# Public/Secret 키는 Langfuse UI에서 프로젝트 생성 후 발급 → keyring으로 이동 권장
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# docker-compose가 요구하는 시크릿 — 한 번 생성해서 고정 유지 (분실 시 DB 복호화 불가)
# 생성: `python -c "import secrets; print(secrets.token_hex(32))"` (각각 다른 값 권장)
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# --- LLM 키 (keyring 권장) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Gmail OAuth (credentials.json 별도, 절대 commit 금지) ---
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=./token.json
GMAIL_LABEL=Newsletter

# --- Tailscale (네트워킹/인증은 tailscaled가 관리; 여기엔 호스트명만) ---
# `tailscale serve --bg --https=443 http://127.0.0.1:8000` 으로 노출된 MagicDNS 이름
# 예: windows-pc.tailxxxxxx.ts.net  — 관리 콘솔 → DNS 에서 확인
TAILSCALE_HOSTNAME=llm-wiki
